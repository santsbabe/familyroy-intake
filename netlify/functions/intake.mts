import type { Config } from "@netlify/functions";
import { getStore,getDeployStore } from "@netlify/blobs";
import { timingSafeEqual } from "node:crypto";
import { buildRecord } from "./core.mjs";
import { prepareEvidence } from "./attachments.mjs";
function storeForEnvironment(){return Netlify.context?.deploy?.context==="production"?getStore("familyroy-intake",{consistency:"strong"}):getDeployStore("familyroy-intake");}
function authorised(req:Request){const expected=Netlify.env.get("FAMILYROY_INTAKE_TOKEN")||"";const supplied=(req.headers.get("authorization")||"").replace(/^Bearer\s+/i,"");if(!expected||!supplied)return false;const a=Buffer.from(expected),b=Buffer.from(supplied);return a.length===b.length&&timingSafeEqual(a,b);}
function validBody(body:any){return body&&typeof body==="object"&&(String(body.text??"").trim().length>0||(Array.isArray(body.attachments)&&body.attachments.length>0));}
function result(record:any,duplicate:boolean){return{ok:true,duplicate,source_id:record.source_id,status:record.status,routes:record.routes,confidence:record.confidence??null,extracted:record.extracted??null,shortcut_message:duplicate?"Already in FamilyRoy":record.status==="needs_review"?"Saved — needs review":"Saved to FamilyRoy"};}
export default async(req:Request)=>{if(req.method!=="POST")return new Response("Method Not Allowed",{status:405,headers:{Allow:"POST"}});if(!authorised(req))return Response.json({ok:false,error:"unauthorized",shortcut_message:"FamilyRoy authentication failed"},{status:401});let body:any;try{body=await req.json();}catch{return Response.json({ok:false,error:"invalid_json",shortcut_message:"FamilyRoy could not read this share"},{status:400});}if(!validBody(body))return Response.json({ok:false,error:"empty_evidence",shortcut_message:"Nothing useful was shared"},{status:422});let prepared:any;try{prepared=prepareEvidence(body);}catch(e:any){const code=e?.message||"invalid_attachment";const status=code==="attachment_too_large"?413:422;return Response.json({ok:false,error:code,shortcut_message:code==="attachment_too_large"?"That file is too large for FamilyRoy":"FamilyRoy could not read that attachment"},{status});}const record=buildRecord(prepared);const store=storeForEnvironment();for(const item of prepared._evidence||[]){await store.set(`evidence/${record.source_id}/${item.meta.sha256}`,item.bytes,{metadata:{name:item.meta.name,mime_type:item.meta.mime_type}});}const key=`sources/${record.source_id}.json`;const existing=await store.get(key,{type:"json"});if(existing)return Response.json(result(existing,true));await store.setJSON(key,record);return Response.json(result(record,false),{status:201});};
export const config:Config={path:"/intake"};