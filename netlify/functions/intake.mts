import { ensureRouteOutbox,pendingRoutesFromEnsure } from "./outbox-core.mjs";
function storeForEnvironment(){return Netlify.context?.deploy?.context==="production"?getStore("familyroy-intake",{consistency:"strong"}):getDeployStore({name:"familyroy-intake",consistency:"strong"});}
function electricityStoreForEnvironment(){return Netlify.context?.deploy?.context==="production"?getStore("familyroy-electricity",{consistency:"strong"}):getStore("familyroy-electricity-preview",{consistency:"strong"});}
function authorised(req:Request){const expected=Netlify.env.get("FAMILYROY_INTAKE_TOKEN")||"";const supplied=(req.headers.get("authorization")||"").replace(/^Bearer\s+/i,"");if(!expected||!supplied)return false;const a=Buffer.from(expected),b=Buffer.from(supplied);return a.length===b.length&&timingSafeEqual(a,b);}
function validBody(body:any){return body&&typeof body==="object"&&(String(body.text??"").trim().length>0||(Array.isArray(body.attachments)&&body.attachments.length>0)||Number.isFinite(Number(body.reading_kwh)));}
async function issueHandoffs(store:any,record:any,pendingRoutes=new Set()){const browserRoutes=new Set(["homework_quest","control_centre.school_readiness"]),handoffs:any={};for(const route of record.routes||[]){if(!browserRoutes.has(route)||!pendingRoutes.has(route))continue;const capability=newCapability(),h=createHandoffRecord({token:capability,route,source_id:record.source_id});await store.setJSON(handoffKey(capability),h);handoffs[route]={capability,expires_at:h.expires_at,delivery:"scoped_handoff"};}return handoffs;}
function result(record:any,duplicate:boolean,handoffs:any={},endpoint=""){const actions=nextActions(record.routes,handoffs),message=shortcutMessage({duplicate,status:record.status,routes:record.routes,handoffs}),primary=choosePrimaryAction(actions),plan=shortcutPlan({shortcut_message:message,primary_action:primary},{intake_endpoint:endpoint,homework_quest:Netlify.env.get("FAMILYROY_HOMEWORK_URL")||"","control_centre.school_readiness":Netlify.env.get("FAMILYROY_CONTROL_CENTRE_URL")||""}),primaryAction=primary?{...primary,launch_url:plan.open_url}:null;return{ok:true,duplicate,source_id:record.source_id,status:record.status,routes:record.routes,confidence:record.confidence??null,extracted:record.extracted??null,handoffs,destinations:destinationSummary(record.routes,handoffs),next_actions:actions,primary_action:primaryAction,launch_url:plan.open_url,handoff_status:handoffStatus(record.routes,handoffs),recovery:recoveryState({status:record.status,duplicate,next_actions:actions}),shortcut_message:message};}
function electricityMessage(record:any){const e=record?.extracted?.electricity;if(!e)return"Meter reading received";if(e.status==="logged"&&e.reading_kwh!==null){const used=e.usage_kwh===null?"":` · ${Number(e.usage_kwh).toFixed(2)} kWh used`;return`Logged: ${Number(e.reading_kwh).toFixed(2)} kWh${used}`;}if(e.anomaly==="reading_increased")return`Check reading: ${Number(e.reading_kwh).toFixed(2)} kWh is higher than the previous reading`;if(e.anomaly==="usage_spike")return`Check reading: ${Number(e.reading_kwh).toFixed(2)} kWh shows unusually high usage`;return"Could not confidently read the meter — saved for review";}
function responseFor(req:Request,record:any,payload:any,status=200){if(new URL(req.url).searchParams.get("response")==="text"&&record.routes?.includes(ROUTES.ELECTRICITY))return new Response(electricityMessage(record),{status,headers:{"content-type":"text/plain; charset=utf-8"}});return Response.json(payload,{status});}
export default async(req:Request)=>{if(req.method!=="POST")return new Response("Method Not Allowed",{status:405,headers:{Allow:"POST"}});if(!authorised(req))return Response.json({ok:false,error:"unauthorized",shortcut_message:"FamilyRoy authentication failed"},{status:401});let body:any;try{body=await req.json();}catch{return Response.json({ok:false,error:"invalid_json",shortcut_message:"FamilyRoy could not read this share"},{status:400});}if(!validBody(body))return Response.json({ok:false,error:"empty_evidence",shortcut_message:"Nothing useful was shared"},{status:422});let prepared:any;try{prepared=prepareEvidence(body);}catch(e:any){const code=e?.message||"invalid_attachment";const status=code==="attachment_too_large"?413:422;return Response.json({ok:false,error:code,shortcut_message:code==="attachment_too_large"?"That file is too large for FamilyRoy":"FamilyRoy could not read that attachment"},{status});}const record=buildRecord(prepared);const store=storeForEnvironment();for(const item of prepared._evidence||[]){await store.set(`evidence/${record.source_id}/${item.meta.sha256}`,item.bytes,{metadata:{name:item.meta.name,mime_type:item.meta.mime_type}});}const key=`sources/${record.source_id}.json`;const existing=await store.get(key,{type:"json"});if(existing){const ensured=await ensureRouteOutbox(store,existing,{repairOnly:true}),pending=pendingRoutesFromEnsure(ensured),handoffs=await issueHandoffs(store,existing,pending);return responseFor(req,existing,result(existing,true,handoffs,new URL(req.url).origin));}if(record.routes.includes(ROUTES.ELECTRICITY)){
  const electricityStore=electricityStoreForEnvironment();
  const latest:any=await electricityStore.get("latest.json",{type:"json"});
  const evidencePath=prepared._evidence?.[0]?.meta?.sha256?`evidence/${record.source_id}/${prepared._evidence[0].meta.sha256}`:(prepared.raw_evidence_ref||null);
  const reading=buildElectricityReading({...prepared,raw_evidence_ref:evidencePath},latest?.reading_kwh??null);
  record.extracted={...(record.extracted||{}),electricity:reading};
  if(record.route_payloads?.[ROUTES.ELECTRICITY])record.route_payloads[ROUTES.ELECTRICITY]={...record.route_payloads[ROUTES.ELECTRICITY],reading};
  if(reading.status==="needs_review")record.status="needs_review";
}
await store.setJSON(key,record);
if(record.routes.includes(ROUTES.ELECTRICITY)&&record.extracted?.electricity?.reading_kwh!==null&&!prepared.client_context?.qa){
  const reading=record.extracted.electricity;
  const safeTimestamp=String(reading.reading_at).replace(/[:]/g,"-");
  const electricityStore=electricityStoreForEnvironment();
  await electricityStore.setJSON(`readings/${safeTimestamp}-${record.source_id}.json`,{source_id:record.source_id,...reading});
  if(reading.status==="logged")await electricityStore.setJSON("latest.json",{source_id:record.source_id,...reading});
}
const ensured=await ensureRouteOutbox(store,record),pending=pendingRoutesFromEnsure(ensured),handoffs=await issueHandoffs(store,record,pending);return responseFor(req,record,result(record,false,handoffs,new URL(req.url).origin),201);};
export const config:Config={path:"/intake"};