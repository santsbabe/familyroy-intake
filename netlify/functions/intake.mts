import type { Config } from "@netlify/functions";
import { getStore,getDeployStore } from "@netlify/blobs";
import { timingSafeEqual } from "node:crypto";
import { buildRecord } from "./core.mjs";
import { prepareEvidence } from "./attachments.mjs";
import { newCapability,handoffKey,createHandoffRecord } from "./handoff-core.mjs";
import { destinationSummary,shortcutMessage,nextActions } from "./orchestration.mjs";
function storeForEnvironment(){return Netlify.context?.deploy?.context==="production"?getStore("familyroy-intake",{consistency:"strong"}):getDeployStore("familyroy-intake");}
function authorised(req:Request){const expected=Netlify.env.get("FAMILYROY_INTAKE_TOKEN")||"";const supplied=(req.headers.get("authorization")||"").replace(/^Bearer\s+/i,"");if(!expected||!supplied)return false;const a=Buffer.from(expected),b=Buffer.from(supplied);return a.length===b.length&&timingSafeEqual(a,b);}
function validBody(body:any){return body&&typeof body==="object"&&(String(body.text??"").trim().length>0||(Array.isArray(body.attachments)&&body.attachments.length>0));}
async function issueHandoffs(store:any,record:any){const browserRoutes=new Set(["homework_quest","control_centre.school_readiness"]),handoffs:any={};for(const route of record.routes||[]){if(!browserRoutes.has(route))continue;const rk=String(route).replace(/[^a-z0-9._-]/gi,"_"),outbox:any=await store.get(`outbox/${rk}/${record.source_id}.json`,{type:"json"});if(!outbox||outbox.status==="consumed")continue;const capability=newCapability(),h=createHandoffRecord({token:capability,route,source_id:record.source_id});await store.setJSON(handoffKey(capability),h);handoffs[route]={capability,expires_at:h.expires_at,delivery:"scoped_handoff"};}return handoffs;}
function result(record:any,duplicate:boolean,handoffs:any={}){return{ok:true,duplicate,source_id:record.source_id,status:record.status,routes:record.routes,confidence:record.confidence??null,extracted:record.extracted??null,handoffs,destinations:destinationSummary(record.routes,handoffs),next_actions:nextActions(record.routes,handoffs),shortcut_message:shortcutMessage({duplicate,status:record.status,routes:record.routes,handoffs})};}
export default async(req:Request)=>{if(req.method!=="POST")return new Response("Method Not Allowed",{status:405,headers:{Allow:"POST"}});if(!authorised(req))return Response.json({ok:false,error:"unauthorized",shortcut_message:"FamilyRoy authentication failed"},{status:401});let body:any;try{body=await req.json();}catch{return Response.json({ok:false,error:"invalid_json",shortcut_message:"FamilyRoy could not read this share"},{status:400});}if(!validBody(body))return Response.json({ok:false,error:"empty_evidence",shortcut_message:"Nothing useful was shared"},{status:422});let prepared:any;try{prepared=prepareEvidence(body);}catch(e:any){const code=e?.message||"invalid_attachment";const status=code==="attachment_too_large"?413:422;return Response.json({ok:false,error:code,shortcut_message:code==="attachment_too_large"?"That file is too large for FamilyRoy":"FamilyRoy could not read that attachment"},{status});}const record=buildRecord(prepared);const store=storeForEnvironment();for(const item of prepared._evidence||[]){await store.set(`evidence/${record.source_id}/${item.meta.sha256}`,item.bytes,{metadata:{name:item.meta.name,mime_type:item.meta.mime_type}});}const key=`sources/${record.source_id}.json`;const existing=await store.get(key,{type:"json"});if(existing){for(const [route,payload] of Object.entries(existing.route_payloads||{})){const rk=String(route).replace(/[^a-z0-9._-]/gi,"_");const ok=`outbox/${rk}/${existing.source_id}.json`;const queued=await store.get(ok,{type:"json"});if(!queued)await store.setJSON(ok,{source_id:existing.source_id,route,payload,status:"pending",created_at:existing.received_at});}const handoffs=await issueHandoffs(store,existing);return Response.json(result(existing,true,handoffs));}await store.setJSON(key,record);for(const [route,payload] of Object.entries(record.route_payloads||{})){const routeKey=String(route).replace(/[^a-z0-9._-]/gi,'_');await store.setJSON(`outbox/${routeKey}/${record.source_id}.json`,{source_id:record.source_id,route,payload,status:'pending',created_at:record.received_at});}const handoffs=await issueHandoffs(store,record);return Response.json(result(record,false,handoffs),{status:201});};
export const config:Config={path:"/intake"};